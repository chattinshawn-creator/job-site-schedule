rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A device can edit once it has been unlocked with the team passcode.
    function isEditor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/editors/$(request.auth.uid));
    }

    // Fields a locked (view-only) device is allowed to change on an existing job.
    function lockedUpdateOk() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly([
          'materialsList', 'materials',
          'obsTour', 'tourDate', 'tourTime', 'tourWho', 'tourCount', 'tourNotes',
          'obsRequity', 'reqDate', 'reqTime', 'reqWho', 'reqCount', 'reqNotes',
          'archQ', 'archQs', 'archText', 'archA', 'archAnsweredAt',
          'media', 'mediaWhat', 'mediaLink',
          'updatedBy', 'updatedAt'])
        && after.get('materialsList', []).size() >= before.get('materialsList', []).size()
        && after.get('archQs', []).size() >= before.get('archQs', []).size()
        && !(before.get('obsTour', false) == true && after.get('obsTour', false) != true)
        && !(before.get('obsRequity', false) == true && after.get('obsRequity', false) != true)
        && !(before.get('media', false) == true && after.get('media', false) != true)
        && !(before.get('archQ', false) == true && after.get('archQ', false) != true);
    }

    // The team passcode lives here. Nobody can read it from the page.
    match /config/{doc} {
      allow read, write: if false;
    }

    // One record per unlocked device. Created only when the passcode matches.
    match /editors/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 80
        && request.resource.data.code == get(/databases/$(database)/documents/config/passcode).data.code;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
    }

    // The schedule: anyone with the link can view; unlocked devices can edit.
    match /projects/{id} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /tasks/{id} {
      allow read: if true;
      allow write: if isEditor();
      // Locked devices may add to and update these sections of an existing job, but not delete from them.
      allow update: if request.auth != null && lockedUpdateOk();
    }
    match /logs/{id} {
      allow read: if true;
      allow write: if isEditor();
    }
  }
}
